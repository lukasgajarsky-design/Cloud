# =============================================================================
#  Instagram Bot – konfigurácia
#  1) Skopíruj tento súbor:   cp .env.example .env
#  2) Doplň hodnoty (návod na získanie tokenov je v README.md)
#  3) Zabezpeč súbor:         chmod 600 .env
#  Súbor .env NIKDY necommituj do gitu (je v .gitignore).
#  Premenné nastavené priamo v prostredí (systemd, Docker) majú prednosť pred .env.
# =============================================================================

# ----------------------------------------------------------------------------
#  Meta Graph API (Instagram)
# ----------------------------------------------------------------------------
# Long-lived access token. Instagram Login: token z App Dashboard (platí 60 dní,
# predĺžiš ho: python main.py --refresh-token). Facebook Login: Page access token.
META_ACCESS_TOKEN=your_meta_access_token

# Číselné ID Instagram biznis/creator účtu (napr. 17841400000000000).
# Overíš ho príkazom: python main.py --check
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# graph.instagram.com = Instagram Login (odporúčané, jednoduchšie)
# graph.facebook.com  = Facebook Login (účet prepojený s Facebook stránkou)
META_GRAPH_HOST=graph.instagram.com
META_API_VERSION=v23.0

# Len pre Facebook Login: ID Facebook stránky prepojenej s Instagramom (pre DM).
META_PAGE_ID=
# Voliteľné, odporúčané pre Facebook Login: App Secret → bot posiela appsecret_proof.
META_APP_SECRET=

# ----------------------------------------------------------------------------
#  Anthropic – Claude Opus 5.5 (hlavný mozog bota)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-opus-5-5

# Úsilie adaptívneho premýšľania: low | medium | high | xhigh | max
#   REPLIES – odpovede na komentáre a DM (rýchlosť + kvalita)
#   CONTENT – popisy príspevkov a scenáre videí
#   LEARN   – hĺbková analýza videa (reverse engineering štýlu)
ANTHROPIC_EFFORT_REPLIES=medium
ANTHROPIC_EFFORT_CONTENT=high
ANTHROPIC_EFFORT_LEARN=high

# Počet automatických opakovaní SDK pri 429/5xx (exponenciálny backoff) a timeout (s).
ANTHROPIC_MAX_RETRIES=5
ANTHROPIC_TIMEOUT_SECONDS=600

# Ak Claude požiadavku odmietne (refusal), API ju zopakuje na odporúčanom záložnom modeli.
ANTHROPIC_SERVER_FALLBACK=true

# ----------------------------------------------------------------------------
#  Prepis reči pre režim --learn
# ----------------------------------------------------------------------------
# openai          = OpenAI Audio API (whisper-1, segmenty s časovými značkami)
# faster-whisper  = lokálny prepis (pip install -r requirements-local-asr.txt)
# none            = bez prepisu, analýza len z obrazu
ASR_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Jazyk reči (ISO 639-1, napr. sk, cs, en). Prázdne = automatická detekcia.
ASR_LANGUAGE=sk
# Veľkosť lokálneho modelu faster-whisper: tiny | base | small | medium | large-v3
FASTER_WHISPER_MODEL=small

# ----------------------------------------------------------------------------
#  Správanie bota (--run)
# ----------------------------------------------------------------------------
ENABLE_COMMENTS=true
ENABLE_DMS=true
ENABLE_POSTS=true
# true = nič neodošle ani nepublikuje, len zapíše do logu, čo by urobil
DRY_RUN=false

POLL_INTERVAL_SECONDS=300
MAX_MEDIA_TO_SCAN=5
MAX_COMMENTS_PER_MEDIA=50
# Na staršie komentáre bot neodpovedá (ochrana pri prvom spustení).
COMMENT_MAX_AGE_HOURS=48
MAX_COMMENT_REPLIES_PER_CYCLE=20
MAX_DM_REPLIES_PER_CYCLE=20
MAX_CONVERSATIONS_TO_SCAN=25
DM_HISTORY_MESSAGES=10
# Minimálny odstup medzi odoslanými odpoveďami/postmi (sekundy).
MIN_SECONDS_BETWEEN_ACTIONS=8
# Pridať @meno autora na začiatok odpovede na komentár.
COMMENT_MENTION_USER=true
COMMENT_REPLY_MAX_CHARS=500
DM_REPLY_MAX_CHARS=900

# ----------------------------------------------------------------------------
#  HTTP retries a rate limiting (Meta Graph API)
# ----------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5
BACKOFF_BASE_SECONDS=2
BACKOFF_MAX_SECONDS=120
# Od akého % využitia limitu (hlavičky X-App-Usage / X-Business-Use-Case-Usage) spomaliť.
USAGE_THROTTLE_THRESHOLD=75
MAX_THROTTLE_SLEEP_SECONDS=60

# ----------------------------------------------------------------------------
#  Plánovanie príspevkov (priečinok queue/)
# ----------------------------------------------------------------------------
QUEUE_DIR=queue
# Verejná HTTPS adresa, na ktorej sú súbory z queue/ dostupné pre Meta.
# Príklad: https://cdn.mojadomena.sk/ig-queue-8f3k2  (súbor queue/post.jpg → .../post.jpg)
MEDIA_PUBLIC_BASE_URL=
VERIFY_MEDIA_URL=true
MAX_POSTS_PER_CYCLE=1
# Súbor musí byť nezmenený aspoň toľko sekúnd (dokončené kopírovanie).
QUEUE_MIN_FILE_AGE_SECONDS=60
BOT_TIMEZONE=Europe/Bratislava

# ----------------------------------------------------------------------------
#  Súbory (relatívne cesty sú od priečinka projektu)
# ----------------------------------------------------------------------------
DATABASE_PATH=data/instagram_bot.db
LOG_FILE=instagram_bot.log
LOG_LEVEL=INFO
BRAND_VOICE_PATH=config/brand_voice.md
STYLE_GUIDE_PATH=config/style_guide.txt
SCRIPTS_OUTPUT_DIR=output/scripts
LOCK_FILE=data/instagram_bot.lock

# ----------------------------------------------------------------------------
#  Režim učenia z videa (--learn)
# ----------------------------------------------------------------------------
# Citlivosť detekcie strihu (0.3 = odporúčané; nižšie = viac strihov).
LEARN_SCENE_THRESHOLD=0.3
# Pravidelné vzorkovanie (snímky za sekundu) popri detekcii scén.
LEARN_SAMPLE_FPS=1
# Max. počet snímok v jednej požiadavke (Claude Opus 5.5 prijme až 600).
LEARN_MAX_FRAMES=240
# Dlhšia strana snímky v px (max. 2000 pri viac ako 20 obrázkoch).
LEARN_FRAME_MAX_SIDE=768
# Kvalita JPEG pre ffmpeg (2 = najlepšia, 31 = najhoršia).
LEARN_JPEG_QUALITY=5
# Prah deduplikácie (Hammingova vzdialenosť z 256 bitov; 0 = len identické).
LEARN_DEDUP_DISTANCE=6
LEARN_MAX_VIDEO_SECONDS=3600
# Limit veľkosti požiadavky na Claude v MB (API max. 32 MB).
LEARN_MAX_REQUEST_MB=28
LEARN_TIMEOUT_SECONDS=1800
# Dĺžka časti audia pri prepise cez OpenAI (limit súboru 25 MB).
LEARN_AUDIO_CHUNK_SECONDS=600
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
